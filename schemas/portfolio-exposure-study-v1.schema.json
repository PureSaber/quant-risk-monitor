{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:puresaber:schema:quant-risk.portfolio-exposure-study:v1",
  "title": "Point-in-time multi-strategy portfolio exposure study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_kind",
    "business_at",
    "knowledge_at",
    "base_currency",
    "position_weight_basis",
    "max_depth",
    "max_age_days",
    "strategies",
    "disclosures"
  ],
  "properties": {
    "schema": {"const": "quant-risk.portfolio-exposure-study/v1"},
    "evidence_kind": {"enum": ["synthetic", "retrospective", "historical_pit"]},
    "business_at": {"type": "string", "format": "date-time"},
    "knowledge_at": {"type": "string", "format": "date-time"},
    "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "position_weight_basis": {"const": "fraction_of_strategy_nav_in_base_currency"},
    "max_depth": {"type": "integer", "minimum": 1},
    "max_age_days": {"type": "integer", "minimum": 0},
    "strategies": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/strategy"}
    },
    "disclosures": {
      "type": "array",
      "items": {"$ref": "#/$defs/disclosure"}
    }
  },
  "$defs": {
    "weight": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "pattern": "^-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"}
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "asset_type", "currency", "weight", "source"],
      "properties": {
        "instrument_id": {"type": "string", "minLength": 1},
        "asset_type": {"enum": ["security", "fund", "cash"]},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "weight": {"$ref": "#/$defs/weight"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_id", "effective_at", "available_at", "source", "positions"],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1},
        "effective_at": {"type": "string", "format": "date-time"},
        "available_at": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "minLength": 1},
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/position"}
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosure_id",
        "fund_id",
        "holding_date",
        "available_at",
        "instrument_id",
        "asset_type",
        "currency",
        "weight",
        "source",
        "evidence_id"
      ],
      "properties": {
        "disclosure_id": {"type": "string", "minLength": 1},
        "fund_id": {"type": "string", "minLength": 1},
        "holding_date": {"type": "string", "format": "date"},
        "available_at": {"type": "string", "format": "date-time"},
        "instrument_id": {"type": "string", "minLength": 1},
        "asset_type": {"enum": ["security", "fund", "cash"]},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "weight": {"$ref": "#/$defs/weight"},
        "source": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
