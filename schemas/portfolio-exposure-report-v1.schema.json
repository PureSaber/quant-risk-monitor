{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:puresaber:schema:quant-risk.portfolio-exposure-report:v1",
  "title": "Point-in-time multi-strategy portfolio exposure report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "evidence_kind",
    "business_at",
    "knowledge_at",
    "base_currency",
    "valuation_contract",
    "provenance",
    "strategies",
    "pairwise",
    "risk_forecast",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "quant-risk.portfolio-exposure-report/v1"},
    "status": {"const": "complete"},
    "evidence_kind": {"enum": ["synthetic", "retrospective", "historical_pit"]},
    "business_at": {"type": "string", "format": "date-time"},
    "knowledge_at": {"type": "string", "format": "date-time"},
    "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "valuation_contract": {"type": "object"},
    "provenance": {"type": "object"},
    "strategies": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/strategyReport"}
    },
    "pairwise": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pairReport"}
    },
    "risk_forecast": {"type": ["object", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "numberOrNull": {"type": ["number", "null"]},
    "coverage": {
      "type": "object",
      "required": ["covered", "unknown", "stale", "future", "cycle", "depth_limit"],
      "properties": {
        "covered": {"$ref": "#/$defs/numberOrNull"},
        "unknown": {"$ref": "#/$defs/numberOrNull"},
        "stale": {"$ref": "#/$defs/numberOrNull"},
        "future": {"$ref": "#/$defs/numberOrNull"},
        "cycle": {"$ref": "#/$defs/numberOrNull"},
        "depth_limit": {"$ref": "#/$defs/numberOrNull"}
      }
    },
    "strategyReport": {
      "type": "object",
      "required": [
        "strategy_id",
        "snapshot",
        "declared",
        "resolved",
        "coverage_gross_weight",
        "coverage_ratio",
        "comparison_eligible",
        "exposures",
        "unavailable_paths"
      ],
      "properties": {
        "strategy_id": {"type": "string"},
        "snapshot": {"type": "object"},
        "declared": {"type": "object"},
        "resolved": {"type": "object"},
        "coverage_gross_weight": {"type": "object"},
        "coverage_ratio": {"$ref": "#/$defs/coverage"},
        "comparison_eligible": {"type": "boolean"},
        "exposures": {"type": "array", "items": {"type": "object"}},
        "unavailable_paths": {"type": "array", "items": {"type": "object"}}
      }
    },
    "pairReport": {
      "type": "object",
      "required": [
        "left_strategy_id",
        "right_strategy_id",
        "status",
        "unavailable_reasons",
        "metric_scope",
        "known_security_gross",
        "shared_known_gross_weight",
        "aligned_known_gross_weight",
        "opposing_known_gross_weight",
        "overlap_ratio_of_smaller_gross",
        "diagnostic_known_only_ratio",
        "common_exposures"
      ],
      "properties": {
        "left_strategy_id": {"type": "string"},
        "right_strategy_id": {"type": "string"},
        "status": {"enum": ["available", "unavailable"]},
        "unavailable_reasons": {"type": "array", "items": {"type": "string"}},
        "metric_scope": {"const": "position_overlap_not_return_correlation_or_risk_forecast"},
        "known_security_gross": {"type": "object"},
        "shared_known_gross_weight": {"type": "number"},
        "aligned_known_gross_weight": {"type": "number"},
        "opposing_known_gross_weight": {"type": "number"},
        "overlap_ratio_of_smaller_gross": {"$ref": "#/$defs/numberOrNull"},
        "diagnostic_known_only_ratio": {"$ref": "#/$defs/numberOrNull"},
        "common_exposures": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
